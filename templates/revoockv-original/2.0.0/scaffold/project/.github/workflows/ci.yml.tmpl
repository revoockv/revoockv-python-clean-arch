# The quality gate on every push and pull request; a pushed tag vX.Y.Z also creates the GitHub release
# with the "## [X.Y.Z]" section of CHANGELOG.md as its notes (rules/ci/ci_cd.md of the template).
name: CI

on:
  push:
    branches: [main, develop]
    tags: ['v[0-9]+.[0-9]+.[0-9]+*']
  pull_request:

jobs:
  quality:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: astral-sh/setup-uv@v6
      - run: uv sync
      - run: uv run ruff check .
      - run: uv run ruff format --check .
      - run: uv run mypy
      - run: uv run pytest -q
      - name: Get the architecture linter
        uses: actions/checkout@v4
        with:
          repository: revoockv/revoockv-python-clean-arch
          path: .clean-arch
      - run: python3 .clean-arch/scripts/py_clean_arch_linter.py --strict

  release:
    if: startsWith(github.ref, 'refs/tags/v')
    needs: quality
    runs-on: ubuntu-latest
    permissions:
      contents: write
    steps:
      - uses: actions/checkout@v4
      - name: Create the GitHub release
        env:
          GH_TOKEN: ${{ github.token }}
          TAG: ${{ github.ref_name }}
        run: |
          version="${TAG#v}"
          awk -v v="$version" '$0 ~ "^## \\[?" v "\\]?( |$)" {on = 1; next} /^## / && on {exit} on' CHANGELOG.md \
            > notes.md 2>/dev/null || true
          if [ -s notes.md ]; then
            gh release create "$TAG" --title "$TAG" --notes-file notes.md --verify-tag
          else
            gh release create "$TAG" --title "$TAG" --generate-notes --verify-tag
          fi
